# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output (Vite / React)
dist/
build/
*.local

# Environment variables
.env
.env.local
.env.*.local

# Firebase service account (if you accidentally put it here)
service-account.json

# IDE / Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Coverage
coverage/

# Vite / Next.js (if any)
.next/
out/

# Misc
*.tmp
*.temp

# APK files (optional – if you don't want to store large APK in Git)
*.apk

# Flutter (if you have a Flutter subfolder)
user_app/.dart_tool/
user_app/build/
user_app/.pub-cache/
user_app/*.aab
user_app/*.apk

# Package manager lock files (keep these if you want, but usually they are tracked)
# package-lock.json
# yarn.lock